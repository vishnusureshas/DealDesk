{
  "name": "dealdesk-assignment",
  "version": "1.0.0",
  "private": true,
  "description": "DealDesk backend assignment: DealDesk API and BillPort fake billing service",
  "workspaces": [
    "dealdesk",
    "billport"
  ],
  "engines": {
    "node": "^20.0.0 || ^22.0.0 || >=24.0.0"
  },
  "scripts": {
